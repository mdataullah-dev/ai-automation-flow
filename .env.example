# Copy this file to `.env` and fill in your own values. The real `.env` is git-ignored.

# Groq API key — used by the Make.com HTTP module that runs the LLM tagging step (Task 2).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Make.com Custom Webhook URL for the skill-tagger scenario (Task 2).
# Copy it from the webhook module in your Make scenario.
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id_here
